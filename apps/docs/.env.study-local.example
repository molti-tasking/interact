# Local testing of the Prolific study, wave 1 (docs/study/local-testing.md).
#
#   cp .env.study-local.example .env.study-local
#   pnpm study:local
#
# Used instead of .env.local, which points at the hosted database. Every
# URL here must be a loopback address; the script refuses anything else.

# --- Local Supabase ----------------------------------------------------------
# From `npx supabase status -o env` in apps/docs (API_URL, ANON_KEY, DB_URL).
# The values below are the defaults of a local stack on supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
STUDY_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- The model ---------------------------------------------------------------
# 1: recorded answers, no model call, no cost. Answers don't follow what you
#    type (a fixed form, fixed questions, a fixed assistant conversation).
# 0: the real model below — every call costs money.
STUDY_MOCK_LLM=1

# What a session runs with (recorded in the session and in every export).
# With STUDY_MOCK_LLM=1, LLM_MODEL_NAME may stay empty ("mock-fixtures").
LLM_MODEL_NAME=
# LLM_FAST_MODEL_NAME=
PROBE_STRATEGY=committee
PROBE_COMMITTEE_SIZE=4

# Only for STUDY_MOCK_LLM=0 — either the gateway (LiteLLM) …
LLM_HOST=
LLM_API_KEY=
# … or Anthropic's API directly:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- The local study ---------------------------------------------------------
STUDY_LOCAL_PORT=3000
# Time limit per form, in minutes (the study uses 12)
STUDY_LOCAL_TASK_MINUTES=12
# The local researcher account the script creates (facilitator page)
STUDY_LOCAL_ADMIN_EMAIL=researcher@study.local
STUDY_LOCAL_ADMIN_PASSWORD=study-local-password
