{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "test -n \"$SUPABASE_DB_URL\" || { echo 'SUPABASE_DB_URL is not set' >&2; exit 1; }; supabase db push --db-url \"$SUPABASE_DB_URL\" --yes",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "unused": "ts-unused-exports tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "eval": "tsx tests/evaluation/run-evaluation.ts",
    "eval:headed": "EVAL_HEADED=true tsx tests/evaluation/run-evaluation.ts",
    "eval:judge-only": "EVAL_SKIP_SIMULATION=true tsx tests/evaluation/run-evaluation.ts",
    "eval:olsen": "tsx tests/evaluation/run-olsen.ts",
    "eval:cdn-evidence": "EVAL_MODE=cdn-evidence tsx tests/evaluation/run-evaluation.ts",
    "eval:cdn-sheets": "tsx tests/evaluation/cdn-scoring-sheet.ts",
    "eval:cdn-agreement": "tsx tests/evaluation/cdn-agreement.ts",
    "fixtures:record": "RECORD_FIXTURES=true pnpm dev",
    "screenshots": "playwright test --project=screenshots",
    "screenshots:paper": "pnpm screenshots && cp tests/screenshots/output/*.png ../../../uist26-malleable-forms/figs/"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.126",
    "@hookform/resolvers": "^5.9.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@next/env": "^16.4.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.304",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "interact": "workspace:^",
    "langfuse": "^3.39.2",
    "lucide-react": "^0.555.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "supabase": "^2.120.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-unused-exports": "^11.0.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.8.0"
  }
}
