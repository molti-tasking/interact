# LLM backend (LiteLLM proxy — used by the app and persona simulation)
LLM_HOST=http://localhost:4000/v1
LLM_API_KEY=xxxxxxxxx
LLM_MODEL_NAME=your-model-name
WHISPER_MODEL_NAME=cavi/faster-whisper-large-v3
# Sampling temperature policy (optional): unset/auto = drop it for models that
# only accept the default (Claude 5 family, o-series, GPT-5), off = never send,
# or a number to force one value for every call.
# LLM_TEMPERATURE=auto

# How design probes are chosen (optional):
#   committee (default) — several independent drafts of the form are compared;
#                         questions ask about what they disagree on, previews ready
#   prompted            — the model is asked for refinement questions (as piloted)
# A study session (briefs mode) only opens when LLM_MODEL_NAME, PROBE_STRATEGY
# and PROBE_COMMITTEE_SIZE are all set explicitly; it records them (and
# LLM_FAST_MODEL_NAME) and puts them in every export.
# PROBE_STRATEGY=committee
# PROBE_COMMITTEE_SIZE=4   # drafts per generation (2–6); costs size + 1 calls
# Tests and recordings only — never for a study: a reproducible order of a
# question's answers instead of a random one.
# NEXT_PUBLIC_OPTION_ORDER_SEED=
# Cheaper model for classification-style calls (intent sync, conflict checks,
# respondent help). Defaults to LLM_MODEL_NAME.
# LLM_FAST_MODEL_NAME=

# Fallback to Anthropic's API when the gateway turns a call away (its rate
# limit, the key's budget, overload, no answer): the same call goes to
# Anthropic directly, and for 60 s after that the gateway is skipped. On as
# soon as ANTHROPIC_API_KEY is set (and LLM_PROVIDER isn't "anthropic").
# The model ids default to LLM_MODEL_NAME / LLM_FAST_MODEL_NAME without a
# leading "anthropic/"; set them when the gateway uses aliases. A study
# session records the fallback with the model it runs with.
# ANTHROPIC_API_KEY=
# LLM_FALLBACK_MODEL_NAME=claude-sonnet-5-5
# LLM_FALLBACK_FAST_MODEL_NAME=
# LLM_FALLBACK=off

# Supabase
NEXT_PUBLIC_SUPABASE_URL=xxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# Langfuse (optional, for LLM tracing)
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASEURL="https://cloud.langfuse.com"

# CDN Evaluation (optional — only needed for `pnpm eval`)
# EVAL_BASE_URL=https://interact-molt.vercel.app  # App URL (default: deployed)
# EVAL_SIM_MODEL=                                  # Override LLM_MODEL_NAME for persona simulation (cheap/fast model)
# EVAL_JUDGE_HOST=                                 # LLM host for judging (defaults to LLM_HOST)
# EVAL_JUDGE_KEY=                                  # API key for judge (defaults to LLM_API_KEY)
# EVAL_JUDGE_MODEL=                                # Model for CDN judging (capable model, e.g. claude-sonnet-4-5-20250514)
# EVAL_JUDGE_RUNS=1                                # Number of judge runs per session
# EVAL_LOGIN_EMAIL=                                # Admin account the persona simulation signs in with
# EVAL_LOGIN_PASSWORD=
