# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
tests/fixtures/_recording-session/
tests/fixtures/.active-scenario

# evaluation runs (timestamped data, not committed)
tests/evaluation/results/run-*/
tests/evaluation/results/olsen-run-*/
tests/evaluation/results/latest
tests/evaluation/results/replay-*
# replay cases converted from study exports: participants' own text
tests/evaluation/replay/private/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.template
# local study settings (pnpm study:local): the example only
!.env.study-local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Written by the demo recording from its seeds, every run
tests/fixtures/demo-recording/
